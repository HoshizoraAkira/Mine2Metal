{
	"schemaVersion": 1,
	"id": "mine2metal",
	"version": "${version}",
	"name": "mine2metal",
	"description": "Renders Minecraft with Apple Metal on Macs with Apple silicon, alongside Sodium, for higher frame rates than OpenGL. Adds MetalFX and AMD FSR upscaling, MetalFX and FSR 3.1 frame generation, and HDR (EDR) output.",
	"authors": [
		"HoshizoraAkira"
	],
	"contact": {
		"homepage": "https://github.com/HoshizoraAkira/Mine2Metal",
		"sources": "https://github.com/HoshizoraAkira/Mine2Metal",
		"issues": "https://github.com/HoshizoraAkira/Mine2Metal/issues"
	},
	"license": "MIT",
	"icon": "assets/mine2metal/icon.png",
	"environment": "client",
	"mixins": [
		"mine2metal.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25"
	},
	"suggests": {
		"sodium": ">=0.9.3-"
	},
	"entrypoints": {
		"sodium:config_api_user": [
			"dev.mine2metal.config.SodiumOptionsPage"
		]
	}
}
